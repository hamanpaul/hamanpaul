{
  "document_type": "integrated-architecture-explainer",
  "version": 7,
  "purpose": "Show testpilot-core control/shared runtime plus wifi_llapi Normal Run and Audit/Calibration as separate flows.",
  "mental_model": [
    {
      "name": "Normal Run = 測 DUT",
      "meaning": "Case YAML 是測試定義；Core 場控，wifi_llapi 執行與判定。"
    },
    {
      "name": "Audit = 測 Case",
      "meaning": "Workbook + source/live evidence 回頭驗證 Case YAML 寫得對不對。"
    },
    {
      "name": "Audit 與 Normal 完全分流",
      "meaning": "Audit 不直接混進 prepare→execute→evaluate 主線。"
    },
    {
      "name": "Focused rerun 才借 Core",
      "meaning": "audit run-queue/runner_facade 需要實機時，才呼叫 Core ExecutionEngine 跑單案。"
    },
    {
      "name": "Transport / RunBackend",
      "meaning": "兩條 flow 都共用劇場設施：命令通道 + session/capture/log。"
    },
    {
      "name": "Apply 是唯一寫回",
      "meaning": "verify-edit / evidence / B-A-C-D gates 通過後，才 apply Case YAML，再建 PR。"
    }
  ],
